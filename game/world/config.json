{
  "version": 2,
  "gameRoot": "game/",
  "startScene": "game",
  "scenes": {
    "game": "world/scenes/game.json"
  },
  "resources": {
    "Renderer": {
      "backend": "sfml",
      "size": { "x": 1280, "y": 720 },
      "title": "R-Type",
      "vsync": true
    },
    "AudioListener": { "backend": "sfml" },
    "Camera": {
      "center": { "x": 960, "y": 540 },
      "size": { "x": 1920, "y": 1080 }
    },
    "ClearColor": { "value": { "r": 4, "g": 4, "b": 14, "a": 255 } },
    "InputManager": {
      "axes": {
        "Horizontal": {
          "positive": "RightArrow",
          "negative": "LeftArrow",
          "joystick": "X",
          "dead": 0.2,
          "invertJoystick": false
        },
        "Vertical": {
          "positive": "UpArrow",
          "negative": "DownArrow",
          "joystick": "Y",
          "dead": 0.2,
          "invertJoystick": true
        }
      },
      "buttons": {
        "Fire": ["Space", "Button0"],
        "Quit": ["Escape", "Button7"],
        "Up": ["UpArrow"],
        "Down": ["DownArrow"],
        "Left": ["LeftArrow"],
        "Right": ["RightArrow"],
        "Next": ["Tab"],
        "Confirm": ["Return", "Button0"],
        "Erase": ["Backspace"],
        "Shift": ["LeftShift", "RightShift"],
        "A": ["A"], "B": ["B"], "C": ["C"], "D": ["D"], "E": ["E"], "F": ["F"], "G": ["G"], "H": ["H"], "I": ["I"],
        "J": ["J"], "K": ["K"], "L": ["L"], "M": ["M"], "N": ["N"], "O": ["O"], "P": ["P"], "Q": ["Q"], "R": ["R"],
        "S": ["S"], "T": ["T"], "U": ["U"], "V": ["V"], "W": ["W"], "X": ["X"], "Y": ["Y"], "Z": ["Z"],
        "0": ["Alpha0"], "1": ["Alpha1"], "2": ["Alpha2"], "3": ["Alpha3"], "4": ["Alpha4"],
        "5": ["Alpha5"], "6": ["Alpha6"], "7": ["Alpha7"], "8": ["Alpha8"], "9": ["Alpha9"]
      }
    }
  }
}
