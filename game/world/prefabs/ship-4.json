{
  "version": 2,
  "name": "Plane of player 4 (noir), tilting up or down with its vertical speed",
  "prefab": "world/prefabs/common/ship.json",
  "components": {
    "Transform": { "origin": { "x": 32, "y": 48, "z": 0 } },
    "Sprite": {
      "texture": "assets/sprites/ship-noir.png",
      "source": { "x": 0, "y": 0, "width": 123, "height": 130 },
      "color": { "r": 255, "g": 255, "b": 255, "a": 255 },
      "layer": 0
    },
    "AnimationStateMachine": {
      "initial": "straight",
      "states": {
        "straight": {
          "frames": [
            { "x": 0, "y": 0, "width": 123, "height": 130 },
            { "x": 123, "y": 0, "width": 123, "height": 130 },
            { "x": 246, "y": 0, "width": 123, "height": 130 },
            { "x": 369, "y": 0, "width": 123, "height": 130 }
          ],
          "frameDuration": 0.07,
          "loop": true
        },
        "up": {
          "frames": [
            { "x": 492, "y": 0, "width": 123, "height": 130 },
            { "x": 615, "y": 0, "width": 123, "height": 130 },
            { "x": 738, "y": 0, "width": 123, "height": 130 },
            { "x": 861, "y": 0, "width": 123, "height": 130 }
          ],
          "frameDuration": 0.07,
          "loop": true
        },
        "down": {
          "frames": [
            { "x": 984, "y": 0, "width": 123, "height": 130 },
            { "x": 1107, "y": 0, "width": 123, "height": 130 },
            { "x": 1230, "y": 0, "width": 123, "height": 130 },
            { "x": 1353, "y": 0, "width": 123, "height": 130 }
          ],
          "frameDuration": 0.07,
          "loop": true
        }
      },
      "params": { "floats": { "speedY": 0 }, "bools": {  } },
      "transitions": [
        {
          "from": "*",
          "to": "up",
          "when": [
            { "param": "speedY", "op": "<", "value": -120 }
          ]
        },
        {
          "from": "*",
          "to": "down",
          "when": [
            { "param": "speedY", "op": ">", "value": 120 }
          ]
        },
        {
          "from": "*",
          "to": "straight",
          "when": [
            { "param": "speedY", "op": ">=", "value": -120 },
            { "param": "speedY", "op": "<=", "value": 120 }
          ]
        }
      ]
    },
    "Scripts": { "scripts": ["scripts/tilt.lua"] }
  }
}
